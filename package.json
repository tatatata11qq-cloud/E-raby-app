{
  "name": "mmm",
  "private": true,
  "version": "1.0.0",
  "description": "منصة إعرابي – نحو أكاديمي (E-raby)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.7.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.eraby.academic",
    "productName": "Eraby",
    "directories": {
      "output": "Release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Eraby-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "إعرابي – نحو أكاديمي"
    },
    "portable": {
      "artifactName": "Eraby-Portable.exe"
    }
  }
}
